// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  username String @unique
  password_hash String
  display_name String
  role Role
  active Boolean @default(true)
  // Audit_Log.user_id and Tokens.issued_by are ON DELETE RESTRICT, so a user
  // who has ever acted cannot be removed without destroying the audit trail.
  // Deleting such a user archives them instead: hidden everywhere, cannot log
  // in, history intact.
  archived Boolean @default(false)
  // Station number shown to staff ("Runner 2", "Cashier 1") and used to pick a
  // specific person at handover. Unique per role; null for roles without one.
  station_number Int?
  sessions Sessions[]
  issued_tokens Tokens[] @relation("IssuedTokens")
  cancelled_tokens Tokens[] @relation("CancelledTokens")
  runner_orders Orders[] @relation("RunnerOrders")
  cashier_orders Orders[] @relation("CashierOrders")
  Audit Audit_Log[]
  requested_regularisations Regularisation[] @relation("RequestedRegularisations")
  decided_regularisations Regularisation[] @relation("DecidedRegularisations")
  frozen_cycles Attendance_Cycle[] @relation("FrozenCycles")

  @@unique([role, station_number])
}

enum Role {
  ADMIN
  PACKAGER
  GREETER
  CASHIER
  RUNNER
}

model Sessions {
  token String @id @default(uuid())
  userId String 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())
  expires_at  DateTime 
}

model Orders {
  id  String @id @default(uuid())
  order_id String @unique
  customer_name String
  phone String
  status Status 
  token_number Int?
  token_date DateTime?
  uploaded_at DateTime @default(now())
  updated_at DateTime @updatedAt
  // Who the order was handed to. Set at handover so each runner/cashier sees
  // only their own queue; null until that stage is reached.
  runner_id String?
  runner User? @relation("RunnerOrders", fields: [runner_id], references: [id])
  cashier_id String?
  cashier User? @relation("CashierOrders", fields: [cashier_id], references: [id])
  // When the order entered READY_FOR_PICKUP — drives the waiting timer on the
  // customer display. Separate from updated_at, which any later edit bumps.
  ready_at DateTime?
  Order_Lines Order_Lines[]
  number_of_items Int
  Token Tokens[]
  Audit Audit_Log[]
}

enum Status {
  PACKAGED
  PACKAGING_PENDING
  HANDOVER
  READY_FOR_PICKUP
  TOKEN_ISSUED
  // Some items handed to the customer, some still outstanding. The order is
  // back in packing for the remainder but must not read as untouched.
  PARTIALLY_DELIVERED
  DELIVERED
}

model Order_Lines {
  id String @id @default(uuid())
  order_ref_id String
  product_name String
  bag_number Int?
  sku_code String?
  sku_description String?
  // Partial handover: a packager can send the bagged lines to the runner and
  // keep the rest in packing, so an order can straddle two stages. The order's
  // own `status` tracks the furthest stage reached; which lines have physically
  // moved is recorded here.
  handed_over Boolean @default(false)
  // Set when the customer actually receives this item. Delivery works per item
  // because an order can reach the counter in more than one trip — the cashier
  // hands over what has arrived and the order stays PARTIALLY_DELIVERED until
  // the rest follows.
  delivered Boolean @default(false)
  order_ref Orders @relation(fields: [order_ref_id], references: [id])
}

model Tokens {
  id Int @id @default(autoincrement())
  issued_date DateTime @default(now())
  status TokenStatus
  issued_by String
  issuer User @relation("IssuedTokens", fields: [issued_by], references: [id])
  cancelled_by String?
  canceller User? @relation("CancelledTokens", fields: [cancelled_by], references: [id])
  cancelled_at DateTime?
  order_ref_id String 
  order_ref Orders @relation(fields: [order_ref_id], references: [id])
}

enum TokenStatus {
  ACTIVE 
  CANCELLED
}

model Audit_Log {
  id String @id @default(uuid())
  at DateTime @default(now())
  user_id String
  user User @relation(fields: [user_id], references: [id])
  username String
  role String
  action String
  details Json?
  order_ref_id String?
  order_ref Orders? @relation(fields: [order_ref_id], references: [id])
}

// ---------------------------------------------------------------------------
// ERP: store roster & biometric attendance (POL-11-01, SOP-11-02/03).
//
// Only facts are stored while a cycle is open (roster, raw punches, approved
// exceptions); verdicts are computed by lib/erp/rules.ts on read, so approving
// a regularisation re-scores every later day in the cycle automatically.
// Verdicts are written to Attendance_Day only when the cycle is frozen.
// Times are minutes from midnight; enum values mirror lib/erp/types.ts.
// ---------------------------------------------------------------------------

// Store staff. Separate from User: most employees never log in.
model Employee {
  id String @id @default(uuid())
  emp_code String @unique
  name String
  gender Gender
  // Roster "ADD Task" column: Footfall Analysis, Trainer, CRM, ...
  task String?
  active Boolean @default(true)
  created_at DateTime @default(now())
  roster Roster_Shift[]
  punches Punch[]
  regularisations Regularisation[]
  attendance_days Attendance_Day[]
  disciplinary Disciplinary_Record[]
}

enum Gender {
  M
  F
}

// One per 19th-to-18th attendance cycle. FROZEN = nothing in it may change.
model Attendance_Cycle {
  id String @id @default(uuid())
  start_date DateTime @unique @db.Date
  end_date DateTime @db.Date
  status CycleStatus @default(OPEN)
  frozen_by String?
  frozen_by_user User? @relation("FrozenCycles", fields: [frozen_by], references: [id])
  frozen_at DateTime?
  days Attendance_Day[]
  disciplinary Disciplinary_Record[]
}

enum CycleStatus {
  OPEN
  FROZEN
}

model Roster_Shift {
  id String @id @default(uuid())
  employee_id String
  employee Employee @relation(fields: [employee_id], references: [id])
  date DateTime @db.Date
  kind ShiftKind
  // Null unless kind is SHIFT.
  start_min Int?
  end_min Int?
  // The 10:45 band that opens the store; any late arrival on it is major.
  is_opening Boolean @default(false)

  @@unique([employee_id, date])
}

enum ShiftKind {
  SHIFT
  WEEKLY_OFF
  LEAVE
  HOLIDAY
}

// Raw biometric record. Regularisations never overwrite it; the engine
// applies them on top so the device's original reading survives for audit.
model Punch {
  id String @id @default(uuid())
  employee_id String
  employee Employee @relation(fields: [employee_id], references: [id])
  date DateTime @db.Date
  in_min Int?
  out_min Int?
  // Groups rows from one biometric sheet upload.
  upload_batch_id String
  uploaded_at DateTime @default(now())

  @@unique([employee_id, date])
}

model Regularisation {
  id String @id @default(uuid())
  employee_id String
  employee Employee @relation(fields: [employee_id], references: [id])
  date DateTime @db.Date
  type RegularisationType
  // Corrected times; null for TIME_EXCEPTION, which only excuses lateness.
  in_min Int?
  out_min Int?
  note String
  status RegularisationStatus @default(PENDING)
  // Employees don't log in, so an admin always enters the request. An admin
  // may not decide a request they entered (checked in the API).
  requested_by String
  requester User @relation("RequestedRegularisations", fields: [requested_by], references: [id])
  requested_at DateTime @default(now())
  decided_by String?
  decider User? @relation("DecidedRegularisations", fields: [decided_by], references: [id])
  decided_at DateTime?

  @@index([employee_id, date])
}

enum RegularisationType {
  MISSED_PUNCH
  DEVICE_FAILURE
  OUTDOOR_DUTY
  TIME_EXCEPTION
}

enum RegularisationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Snapshot of the engine's verdict, written once when the cycle is frozen.
model Attendance_Day {
  id String @id @default(uuid())
  cycle_id String
  cycle Attendance_Cycle @relation(fields: [cycle_id], references: [id])
  employee_id String
  employee Employee @relation(fields: [employee_id], references: [id])
  date DateTime @db.Date
  outcome DayOutcome
  deduction Deduction
  severity LateSeverity?
  occurrence_no Int?
  // Times are copied in so the frozen record stands on its own for payroll.
  start_min Int?
  end_min Int?
  in_min Int?
  out_min Int?
  missed_punch Boolean
  late_minutes Int
  early_minutes Int
  span_minutes Int
  reasons Json

  @@unique([employee_id, date])
}

enum DayOutcome {
  PRESENT
  EXCUSED
  LATE
  HALF_DAY
  FULL_DAY_LEAVE
  MISSED_PUNCH_PENDING
  ABSENT
  WEEKLY_OFF
  LEAVE
  HOLIDAY
}

enum Deduction {
  NONE
  HALF_LEAVE
  FULL_LEAVE
  UNPAID
}

enum LateSeverity {
  MINOR
  MAJOR
}

// Cumulative disciplinary record. Unlike the late counter it never resets.
model Disciplinary_Record {
  id String @id @default(uuid())
  employee_id String
  employee Employee @relation(fields: [employee_id], references: [id])
  cycle_id String
  cycle Attendance_Cycle @relation(fields: [cycle_id], references: [id])
  kind DisciplinaryKind
  date DateTime @db.Date
  created_at DateTime @default(now())
}

enum DisciplinaryKind {
  WARNING_1
  WARNING_2
  SHOW_CAUSE
  MISSED_PUNCH_CAUTION
}
